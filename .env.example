# Q-Planning local configuration.
#
#   cp .env.example .env    then fill in the placeholders below.
#
# Nothing in this repository hardcodes a path. Every location the code needs is read from
# one of the variables here (or from the equivalent key in a config YAML, which wins).
# Run `qplanning doctor --config <a config>` at any point to see which of these resolve.
#
# Values may be either a local directory or a Hugging Face repo id (`org/name`), which is
# downloaded on first use. Anything relative is resolved against the repository root.

# ---------------------------------------------------------------------------------------
# Where everything this project writes or downloads goes.
# Budget ~70 GB for checkpoints alone; a full 10-iteration self-improvement run adds ~250 GB.
# Point this at scratch or another large volume, not at your home directory.
# ---------------------------------------------------------------------------------------
QPLANNING_ROOT=./artifacts

# ---------------------------------------------------------------------------------------
# Frozen behaviour-cloning policy checkpoints (FastWAM). Never updated by Q-Planning.
# ---------------------------------------------------------------------------------------
QPLANNING_BC_CKPT_LIBERO=<TODO: local dir or HF repo id>
QPLANNING_BC_CKPT_ROBOTWIN=<TODO: local dir or HF repo id>

# ---------------------------------------------------------------------------------------
# Q-function checkpoints. Skip these if you are training your own with `qplanning train-q`.
# ---------------------------------------------------------------------------------------
QPLANNING_Q_CKPT_LIBERO=<TODO: local dir or HF repo id>
QPLANNING_Q_CKPT_ROBOTWIN=<TODO: local dir or HF repo id>

# ---------------------------------------------------------------------------------------
# Wan2.2 base weights that FastWAM's VAE and text encoder load from (~24 GB).
# These are NOT inside the FastWAM checkpoint and must be fetched separately -- see
# docs/setup.md. A partial download fails with an opaque "Cannot detect model type"
# error, so let `qplanning doctor` check it before you launch anything long.
# ---------------------------------------------------------------------------------------
QPLANNING_WAN22_DIR=<TODO: directory containing Wan-AI/ and DiffSynth-Studio/>

# ---------------------------------------------------------------------------------------
# Demonstration datasets (LeRobotDataset format), used for Q training and for the offline
# half of every self-improvement minibatch.
# ---------------------------------------------------------------------------------------
QPLANNING_DATA_ROOT=<TODO: LIBERO LeRobotDataset root>
QPLANNING_ROBOTWIN_DATASET_ROOT=<TODO: RoboTwin 2.0 LeRobotDataset root>

# ---------------------------------------------------------------------------------------
# RoboTwin evaluation only: a clone of the RoboTwin repository, already built.
# RoboTwin needs its own environment; see docs/setup.md section 3.
# ---------------------------------------------------------------------------------------
ROBOTWIN_ROOT=<TODO: path to your RoboTwin checkout>

# ---------------------------------------------------------------------------------------
# Optional.
# ---------------------------------------------------------------------------------------
# Shared Hugging Face cache. Must be writable -- a read-only cache makes datasets' file
# locking fail. Defaults to the standard HF location.
# QPLANNING_HF_HOME=

# Weights & Biases. Leave the project empty to disable logging entirely.
# QPLANNING_WANDB_PROJECT=
# QPLANNING_WANDB_ENTITY=

# Read by scripts/run.sh: the interpreter to use, and a file to write the run log to.
# QPLANNING_PYTHON=python
# QPLANNING_LOG=
