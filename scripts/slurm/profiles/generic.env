# Template SLURM profile. Copy to <yourcluster>.env and fill in.
# Every value here is passed to sbatch on the command line by submit.sh.

QP_ACCOUNT=""              # e.g. my-allocation; leave empty if your cluster has no accounts
QP_PARTITION=""            # e.g. gpu
QP_QOS=""                  # e.g. normal
# One GPU. Evaluation needs >= 32 GB of VRAM and bfloat16 support (compute capability
# 8.0+). Name the GPU type explicitly if your scheduler supports it -- an untyped request
# is filled with whatever is free, which is how a job ends up on a card too small to hold
# the policy and fails with an out-of-memory error that looks like a bug in the code.
#   e.g. QP_GRES="gpu:a100:1"
QP_GRES="gpu:1"
QP_TIME="04:00:00"
QP_MEM="64G"               # per GPU
QP_CPUS="4"                # per GPU
QP_EXTRA=""                # any additional sbatch flags

# The interpreter on the compute node. conda activate is unreliable in batch shells, so
# point at the interpreter directly.
export QPLANNING_PYTHON="python"
